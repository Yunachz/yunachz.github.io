---
import '../styles/v3.css';
import { getCollection } from 'astro:content';
import { sitePath } from '../lib/urls';

interface Props {
  title: string;
  titleEn: string;
  description: string;
  descriptionEn: string;
  canonicalPath?: string;
  profileName: string;
  navItems: Array<{ label: string; labelEn: string; href: string }>;
}

const { title, titleEn, description, descriptionEn, canonicalPath = '/', profileName, navItems } = Astro.props;
const entries = await getCollection('site');
const settings = entries.find(({ data }) => data.kind === 'settings')?.data;
const contact = entries.find(({ data }) => data.kind === 'contact')?.data;
if (!settings || settings.kind !== 'settings' || !contact || contact.kind !== 'contact') throw new Error('Site settings and contact are required.');
const canonical = new URL(sitePath(canonicalPath), settings.siteUrl).href;
const personData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profileName,
  url: settings.siteUrl,
  sameAs: [contact.github, contact.linkedin],
};
---

<!doctype html>
<html lang="id" data-title-id={title} data-title-en={titleEn} data-description-id={description} data-description-en={descriptionEn} data-v6-home-page={canonicalPath === '/' ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f4f5f2" />
    <meta name="description" content={description} data-meta-description />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={sitePath('/favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:title" content={title} data-meta-title />
    <meta property="og:description" content={description} data-meta-og-description />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let theme = 'system';
        let locale = 'id';
        try {
          const savedTheme = localStorage.getItem('portfolio-theme');
          const savedLocale = localStorage.getItem('portfolio-locale');
          if (savedTheme === 'light' || savedTheme === 'dark') theme = savedTheme;
          if (savedLocale === 'id' || savedLocale === 'en') locale = savedLocale;
        } catch {}
        root.dataset.themeMode = theme;
        root.dataset.theme = theme === 'system'
          ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          : theme;
        root.dataset.locale = locale;
        if (root.hasAttribute('data-v6-home-page') && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          root.dataset.v6EntrancePreflight = 'true';
          window.setTimeout(() => {
            if (root.dataset.v6EntrancesReady === 'true') return;
            root.dataset.v6EntrancePreflightExpired = 'true';
            delete root.dataset.v6EntrancePreflight;
          }, 1800);
        }
        if (locale === 'en') {
          root.classList.add('locale-pending');
          window.setTimeout(() => root.classList.remove('locale-pending'), 1500);
        }
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(personData)}></script>
  </head>
  <body>
    <div class="ambient-gradient" data-ambient-gradient aria-hidden="true">
      <span class="ambient-gradient__orb ambient-gradient__orb--top-blue" data-ambient-orb="top-blue"></span>
      <span class="ambient-gradient__orb ambient-gradient__orb--top-warm" data-ambient-orb="top-warm"></span>
      <span class="ambient-gradient__orb ambient-gradient__orb--middle-teal" data-ambient-orb="middle-teal"></span>
      <span class="ambient-gradient__orb ambient-gradient__orb--middle-blue" data-ambient-orb="middle-blue"></span>
      <span class="ambient-gradient__orb ambient-gradient__orb--bottom-blue" data-ambient-orb="bottom-blue"></span>
    </div>
    <a class="skip-link" href="#main-content" data-copy-id="Lewati ke konten utama" data-copy-en="Skip to main content">Lewati ke konten utama</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-brand" href={sitePath('/')} aria-label="Fajar, beranda" data-aria-id="Fajar, beranda" data-aria-en="Fajar, home" data-v6-enter="header:brand" data-v6-safe="true">
          <span>Fajar.</span>
        </a>
        <nav class="primary-navigation" id="primary-navigation" aria-label="Navigasi utama" data-aria-id="Navigasi utama" data-aria-en="Main navigation">
          <ul>
            {navItems.map((item) => <li><a href={item.href} data-copy-id={item.label} data-copy-en={item.labelEn} data-v6-enter={'header:nav-' + item.href.replace('#', '')} data-v6-safe="true">{item.label}</a></li>)}
          </ul>
        </nav>
        <div class="site-header__controls">
          <button class="icon-button theme-toggle" type="button" data-theme-toggle aria-label="Gunakan tema gelap" data-aria-id="Gunakan tema gelap" data-aria-en="Switch to dark theme" data-v6-enter="header:theme" data-v6-safe="true" hidden>
            <svg class="theme-toggle__sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="theme-toggle__moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 15.2A8.5 8.5 0 0 1 8.8 3.5 8.5 8.5 0 1 0 20.5 15.2Z"/></svg>
          </button>
          <button class="locale-toggle" type="button" data-locale-toggle aria-label="Bahasa Indonesia aktif; ubah ke English" data-v6-enter="header:locale" data-v6-safe="true">
            <span class="locale-toggle__option" data-locale-choice="en">EN</span>
            <span class="locale-toggle__separator" aria-hidden="true">|</span>
            <span class="locale-toggle__option is-active" data-locale-choice="id">ID</span>
          </button>
          <button class="icon-button menu-toggle" id="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation" aria-label="Buka menu" data-aria-id="Buka menu" data-aria-en="Open menu" data-v6-enter="header:menu" data-v6-safe="true" hidden>
            <svg class="menu-toggle__open" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            <svg class="menu-toggle__close" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
          </button>
        </div>
      </div>
    </header>
    <main id="main-content" tabindex="-1" data-v6-home={canonicalPath === '/' ? '' : undefined}><slot /></main>
    <dialog class="site-dialog" id="content-dialog" aria-modal="true">
      <div class="site-dialog__toolbar">
        <button class="dialog-close icon-button" type="button" data-dialog-close aria-label="Tutup dialog" data-aria-id="Tutup dialog" data-aria-en="Close dialog">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
        </button>
      </div>
      <div class="site-dialog__content" data-dialog-content></div>
    </dialog>
    <script>
      import '../scripts/v3-ui';
    </script>
  </body>
</html>
