---
import { getCollection } from 'astro:content';
import PortfolioLayout from '../layouts/PortfolioLayoutV3.astro';
import { categoriesForProjects, categoryLabelForProject } from '../lib/project-categories';
import { buildCredentialDisplayPages } from '../lib/credential-pagination';
import { translate } from '../lib/i18n';
import { sitePath } from '../lib/urls';
import { segmentGraphemes } from '../lib/v6-entrance-state.mjs';
import AboutLanyard from './AboutLanyard.jsx';
import CredentialGlareEnhancement from './CredentialGlareEnhancement.jsx';
import CompetitionSection from './CompetitionSection.astro';
import AboutMotion from './AboutMotion.astro';
import { lanyardConfig } from '../data/lanyard';

const siteEntries = await getCollection('site');
const profile = siteEntries.find((entry) => entry.data.kind === 'profile')?.data;
const contact = siteEntries.find((entry) => entry.data.kind === 'contact')?.data;
const settings = siteEntries.find((entry) => entry.data.kind === 'settings')?.data;
if (!profile || profile.kind !== 'profile' || !contact || contact.kind !== 'contact' || !settings || settings.kind !== 'settings') {
  throw new Error('Profile, contact, and site settings are required.');
}

const projectCollection = (await getCollection('projects')).filter(({ data }) => !data.draft).sort((a, b) => a.data.order - b.data.order || a.data.slug.localeCompare(b.data.slug));
const skills = (await getCollection('skills')).filter(({ data }) => !data.draft).sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id));
const skillGroups = (await getCollection('skillGroups')).filter(({ data }) => !data.draft).sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id));
const experience = (await getCollection('experience')).filter(({ data }) => !data.draft).sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id));
const education = (await getCollection('education')).filter(({ data }) => !data.draft).sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id));
const credentials = (await getCollection('credentials')).filter(({ data }) => !data.draft).sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id));
const credentialSamples = (await getCollection('credentialSamples')).filter(({ data }) => !data.draft).sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id));
const competitions = (await getCollection('competitions')).filter(({ data }) => !data.draft).sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id));
const software = (await getCollection('software')).filter(({ data }) => !data.draft).sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id));
const credentialPages = buildCredentialDisplayPages(credentials, credentialSamples);
const categories = categoriesForProjects(projectCollection.map(({ data }) => data));
const formalEducation = education.filter(({ data }) => data.categoryId === 'formal');
const nonformalEducation = education.filter(({ data }) => data.categoryId === 'nonformal');
const ojt = experience.find(({ data }) => data.categoryId === 'ojt');
const organizations = experience.filter(({ data }) => data.categoryId === 'organization');
const committees = experience.filter(({ data }) => data.categoryId === 'committee');
const cvSkills = skills.filter(({ data }) => data.cvOrder).sort((a, b) => (a.data.cvOrder ?? 99) - (b.data.cvOrder ?? 99));

const monthLabels = {
  id: ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'],
  en: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
};
function monthLabel(value: string, locale: 'id' | 'en') {
  const year = value.slice(0, 4);
  const month = Number(value.slice(5, 7));
  return `${monthLabels[locale][month - 1] ?? ''} ${year}`;
}
function periodLabel(dates: { start: string; kind: 'range' | 'ongoing' | 'single'; end?: string | undefined }, locale: 'id' | 'en') {
  if (dates.kind === 'single') return monthLabel(dates.start, locale);
  if (dates.kind === 'ongoing') return `${monthLabel(dates.start, locale)} – ${locale === 'id' ? 'Sekarang' : 'Present'}`;
  return `${monthLabel(dates.start, locale)} – ${monthLabel(dates.end!, locale)}`;
}
const id = (key: Parameters<typeof translate>[1], params?: Record<string, string | number>) => translate('id', key, params);
const en = (key: Parameters<typeof translate>[1], params?: Record<string, string | number>) => translate('en', key, params);
const copyAttrs = (indonesian: string, english: string) => ({ 'data-copy-id': indonesian, 'data-copy-en': english });
const ariaAttrs = (indonesian: string, english: string) => ({ 'data-aria-id': indonesian, 'data-aria-en': english });
const headingSegments = (text: string) => segmentGraphemes(text, 'id');
const cvPathId = sitePath(profile.cvByLocale.id);
const cvPathEn = sitePath(profile.cvByLocale.en);
const profileLanguages = profile.languages.map((language) => ({
  id: `${language.name.id} · ${language.level.id}`,
  en: `${language.name.en} · ${language.level.en}`,
}));
const profileLanguagesId = profileLanguages.map(({ id: value }) => value).join(' / ');
const profileLanguagesEn = profileLanguages.map(({ en: value }) => value).join(' / ');
const profileGpaId = profile.gpa?.toFixed(2).replace('.', ',') ?? '';
const profileGpaEn = profile.gpa?.toFixed(2) ?? '';
const projectCountId = projectCollection.length === 1 ? id('projects.countOne') : id('projects.countMany', { count: projectCollection.length });
const projectCountEn = projectCollection.length === 1 ? en('projects.countOne') : en('projects.countMany', { count: projectCollection.length });

const navItems = [
  { key: 'nav.about', href: '#about' },
  { key: 'nav.projects', href: '#projects' },
  { key: 'nav.skills', href: '#skills' },
  { key: 'nav.education', href: '#education' },
  { key: 'nav.experience', href: '#experience' },
  { key: 'nav.competitions', href: '#competitions' },
  { key: 'nav.credentials', href: '#credentials' },
  { key: 'nav.contact', href: '#contact' },
] as const;
---

<PortfolioLayout
  title={id('meta.title')}
  titleEn={en('meta.title')}
  description={id('meta.description')}
  descriptionEn={en('meta.description')}
  canonicalPath="/"
  profileName={profile.name}
  navItems={navItems.map((item) => ({ href: item.href, label: id(item.key), labelEn: en(item.key) }))}
>
  <section class="hero content-shell" id="about" aria-labelledby="page-title">
    <AboutMotion />
    <div class="hero__copy">
      <h1 id="page-title" data-v6-heading data-v6-type data-v6-enter="hero:title">
        <span class="v6-heading__source" data-copy-id={profile.name} data-copy-en={profile.name}>{profile.name}</span>
        <span class="v6-heading__visual" aria-hidden="true">
          {headingSegments(profile.name).map((grapheme) => <span class="v6-heading__grapheme">{grapheme}</span>)}
        </span>
      </h1>
      <p class="hero__field" data-v6-enter="hero:field" data-v6-preset="copy" {...copyAttrs(profile.copy.id.field, profile.copy.en.field)}>{profile.copy.id.field}</p>
      <p class="hero__intro" data-v6-enter="hero:intro" data-v6-preset="copy" {...copyAttrs(profile.copy.id.summary, profile.copy.en.summary)}>{profile.copy.id.summary}</p>
      <div class="hero__facts" aria-label="Fakta singkat tentang Fajar" data-aria-id="Fakta singkat tentang Fajar" data-aria-en="A few facts about Fajar">
        <div class="hero-fact" data-v6-enter="hero:fact:gpa">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c0 2 3 3 6 3s6-1 6-3v-5"/></svg>
          <span class="hero-fact__label" {...copyAttrs(id('facts.gpaLabel'), en('facts.gpaLabel'))}>{id('facts.gpaLabel')}</span>
          <strong class="hero-fact__value" {...copyAttrs(profileGpaId, profileGpaEn)}>{profileGpaId}</strong>
        </div>
        <div class="hero-fact" data-v6-enter="hero:fact:location">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Z"/><circle cx="12" cy="9" r="2.2"/></svg>
          <span class="hero-fact__label" {...copyAttrs(id('facts.locationLabel'), en('facts.locationLabel'))}>{id('facts.locationLabel')}</span>
          <strong class="hero-fact__value" {...copyAttrs(profile.location ?? id('facts.location'), profile.location ?? en('facts.location'))}>{profile.location}</strong>
        </div>
        <div class="hero-fact hero-fact--languages" data-v6-enter="hero:fact:languages">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3.8 9h16.4M3.8 15h16.4M12 3c2.2 2.4 3.2 5.4 3.2 9s-1 6.6-3.2 9c-2.2-2.4-3.2-5.4-3.2-9S9.8 5.4 12 3Z"/></svg>
          <span class="hero-fact__label" {...copyAttrs('Bahasa', 'Languages')}>{'Bahasa'}</span>
          <strong class="hero-fact__value" {...copyAttrs(profileLanguagesId, profileLanguagesEn)}>{profileLanguagesId}</strong>
        </div>
      </div>
      <div class="hero__actions">
        <button class="button button--primary" type="button" data-cv-open data-v6-enter="hero:action:cv" data-v6-delay="0" data-cv-id-url={cvPathId} data-cv-en-url={cvPathEn} hidden>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3.5h7l4 4v13H7z"/><path d="M14 3.5v4h4M10 12h5M10 15h5"/></svg>
          <span data-copy-id={id('hero.cv')} data-copy-en={en('hero.cv')}>{id('hero.cv')}</span>
        </button>
        <a class="button button--quiet" href="#projects" data-v6-enter="hero:action:projects" data-v6-delay="0">
          <span data-copy-id={id('hero.projects')} data-copy-en={en('hero.projects')}>{id('hero.projects')}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v15M6 13l6 6 6-6"/></svg>
        </a>
      </div>
      <noscript>
        <div class="noscript-cv-links">
          <a href={cvPathId} target="_blank" rel="noopener">Unduh CV Bahasa Indonesia</a>
          <a href={cvPathEn} target="_blank" rel="noopener">Download English CV</a>
        </div>
      </noscript>
    </div>
    <figure class="hero-portrait" data-v6-enter="hero:lanyard" data-v6-delay="0" data-v6-requires-ready="true" data-v6-enter-target=".hero-portrait__stage" data-lanyard-state="fallback">
      <div class="hero-portrait__fallback">
        <span class="hero-portrait__fallback-strap" aria-hidden="true"></span>
        <span class="hero-portrait__fallback-ring" aria-hidden="true"></span>
        <span class="hero-portrait__fallback-clamp" aria-hidden="true"></span>
        <img
          class="hero-portrait__fallback-photo"
          src={sitePath(profile.photo ?? '')}
          alt={profile.copy.id.photoAlt}
          data-alt-id={profile.copy.id.photoAlt}
          data-alt-en={profile.copy.en.photoAlt}
          width={profile.photoWidth}
          height={profile.photoHeight}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
      <div class="hero-portrait__stage" aria-hidden="true">
        <AboutLanyard
          client:visible
          frontImage={sitePath(lanyardConfig.frontImage)}
          backImage={sitePath(lanyardConfig.backImage)}
          strapImage={sitePath(lanyardConfig.strapImage)}
          settings={lanyardConfig}
        />
      </div>
    </figure>
  </section>

  <section class="section-block content-shell project-section" id="projects" aria-labelledby="projects-heading">
    <header class="section-heading">
      <div>
        <h2 id="projects-heading" data-v6-heading data-v6-type data-v6-enter="heading:projects">
          <span class="v6-heading__source" {...copyAttrs(id('projects.title'), en('projects.title'))}>{id('projects.title')}</span>
          <span class="v6-heading__visual" aria-hidden="true">{headingSegments(id('projects.title')).map((grapheme) => <span class="v6-heading__grapheme">{grapheme}</span>)}</span>
        </h2>
        <p data-v6-enter="projects:intro" data-v6-preset="copy" {...copyAttrs(id('projects.intro'), en('projects.intro'))}>{id('projects.intro')}</p>
      </div>
      <a class="text-link section-heading__link" href={sitePath('/projects/')} data-v6-enter="projects:archive" data-v6-delay="0">
        <span data-copy-id={`${id('projects.more')} (${projectCollection.length})`} data-copy-en={`${en('projects.more')} (${projectCollection.length})`}>{id('projects.more')} ({projectCollection.length})</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
      </a>
    </header>
    <div class="project-toolbar" data-v6-enter="projects:toolbar" data-v6-delay="0">
      <div class="project-filters" role="group" aria-label={id('projects.filterLabel')} data-aria-id={id('projects.filterLabel')} data-aria-en={en('projects.filterLabel')}>
        <button type="button" class="filter-chip is-active" data-project-filter="all" aria-pressed="true" disabled {...copyAttrs(id('projects.all'), en('projects.all'))}>{id('projects.all')}</button>
        {categories.map((category) => (
          <button type="button" class="filter-chip" data-project-filter={category.id} aria-pressed="false" disabled {...copyAttrs(category.label.id, category.label.en)}>{category.label.id}</button>
        ))}
      </div>
      <div class="project-toolbar__controls">
        <span class="project-count" data-project-count {...copyAttrs(projectCountId, projectCountEn)}>{projectCountId}</span>
        <div class="carousel-controls" data-project-controls hidden>
          <button class="icon-button" type="button" data-project-previous aria-label={id('projects.previous')} data-aria-id={id('projects.previous')} data-aria-en={en('projects.previous')}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
          </button>
          <button class="icon-button" type="button" data-project-toggle aria-label={id('projects.pause')} data-aria-id={id('projects.pause')} data-aria-en={en('projects.pause')} aria-pressed="false">
            <svg data-icon-pause viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14M16 5v14"/></svg>
            <svg data-icon-play viewBox="0 0 24 24" aria-hidden="true" style="display: none"><path d="m8 5 11 7-11 7z"/></svg>
          </button>
          <button class="icon-button" type="button" data-project-next aria-label={id('projects.next')} data-aria-id={id('projects.next')} data-aria-en={en('projects.next')}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </button>
        </div>
      </div>
    </div>
    <p class="visually-hidden" data-project-status role="status" aria-live="polite"></p>
    <div class="project-carousel" data-project-carousel data-user-paused="false">
      <div class="project-carousel__stage" data-project-stage role="region" aria-roledescription="carousel" aria-label={id('projects.galleryLabel')} data-aria-id={id('projects.galleryLabel')} data-aria-en={en('projects.galleryLabel')}>
        {projectCollection.map((project, index) => {
          const data = project.data;
          const categoryLabel = categoryLabelForProject(data.categoryIds);
          const payload = JSON.stringify({
            slug: data.slug,
            title: data.title,
            category: categoryLabel,
            copy: data.copy,
            media: { ...data.media, src: sitePath(data.media.src) },
            tags: data.tags,
            repositoryUrl: data.repositoryUrl,
            demoUrl: data.demoUrl,
            sourceLinks: data.sourceLinks,
            url: sitePath(`/projects/${data.slug}/`),
          });
          return (
            <article class="project-slide" data-project-slide data-v6-enter={`project:${data.slug}`} data-v6-preset="editorial" data-v6-enter-target=".project-slide__visual" data-v6-delay="0" data-project-id={data.slug} data-project-payload={payload} data-categories={data.categoryIds.join(' ')} data-position={index}>
              <div class="project-slide__visual">
              <a class="project-card" href={sitePath(`/projects/${data.slug}/`)} data-project-open {...ariaAttrs(id('projects.openDetail', { title: data.title }), en('projects.openDetail', { title: data.title }))} aria-label={id('projects.openDetail', { title: data.title })}>
                <figure class="project-card__media">
                  <img
                    src={sitePath(data.media.src)}
                    alt={data.copy.id.imageAlt}
                    data-alt-id={data.copy.id.imageAlt}
                    data-alt-en={data.copy.en.imageAlt}
                    width={data.media.width}
                    height={data.media.height}
                    loading={index === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </figure>
                <div class="project-card__body">
                  <div class="project-card__heading">
                    <h3>{data.title}</h3>
                    <span class="project-card__category" {...copyAttrs(categoryLabel.id, categoryLabel.en)}>{categoryLabel.id}</span>
                  </div>
                  <p class="project-card__summary" {...copyAttrs(data.copy.id.summary, data.copy.en.summary)}>{data.copy.id.summary}</p>
                  <ul class="tag-list" aria-label={id('projects.technologyLabel', { title: data.title })} data-aria-id={id('projects.technologyLabel', { title: data.title })} data-aria-en={en('projects.technologyLabel', { title: data.title })}>
                    {data.tags.map((tag) => <li>{tag}</li>)}
                  </ul>
                </div>
              </a>
              </div>
            </article>
          );
        })}
      </div>
      <p class="empty-note" data-project-empty hidden {...copyAttrs(id('projects.empty'), en('projects.empty'))}>{id('projects.empty')}</p>
    </div>
  </section>

  <section class="section-block content-shell skills-section" id="skills" aria-labelledby="skills-heading">
    <header class="section-heading">
      <div>
        <h2 id="skills-heading" data-v6-heading data-v6-type data-v6-enter="heading:skills">
          <span class="v6-heading__source" {...copyAttrs(id('skills.title'), en('skills.title'))}>{id('skills.title')}</span>
          <span class="v6-heading__visual" aria-hidden="true">{headingSegments(id('skills.title')).map((grapheme) => <span class="v6-heading__grapheme">{grapheme}</span>)}</span>
        </h2>
        <p data-v6-enter="skills:intro" data-v6-preset="copy" {...copyAttrs(id('skills.intro'), en('skills.intro'))}>{id('skills.intro')}</p>
      </div>
    </header>
    <div class="skill-tabs" data-skill-tabs data-v6-enter="skills:tabs" data-v6-delay="0" role="tablist" aria-label={id('skills.tabsLabel')} data-aria-id={id('skills.tabsLabel')} data-aria-en={en('skills.tabsLabel')}>
      <button type="button" role="tab" id="skills-tab" aria-controls="skills-panel" aria-selected="true" tabindex="0" data-skill-tab="skills" hidden {...copyAttrs(id('skills.tab'), en('skills.tab'))}>{id('skills.tab')}</button>
      <button type="button" role="tab" id="software-tab" aria-controls="software-panel" aria-selected="false" tabindex="-1" data-skill-tab="software" hidden {...copyAttrs(id('software.tab'), en('software.tab'))}>{id('software.tab')}</button>
    </div>
    <div class="skills-panel" id="skills-panel" role="tabpanel" aria-labelledby="skills-tab" data-skill-panel="skills">
      <div class="skills-strip" data-skills-strip data-skill-group-count={skillGroups.length} data-canonical-skill-count={skills.length}>
        {skillGroups.map((group) => {
          const representativeSkill = skills.find(({ id: skillId }) => group.data.skillIds.includes(skillId));
          const ariaId = id('skills.expand', { title: group.data.copy.id.title });
          const ariaEn = en('skills.expand', { title: group.data.copy.en.title });
          return (
            <article class="skill-card" data-skill-card data-v6-enter={`skill:${group.id}`} data-v6-delay="0" data-skill-id={group.id} data-skill-ids={group.data.skillIds.join(' ')} data-chip-count={group.data.chips.length} data-active="false" style={representativeSkill ? `--skill-art: url('${sitePath(representativeSkill.data.media.src)}')` : undefined}>
              <button class="skill-card__button" type="button" data-skill-activate disabled aria-expanded="false" aria-controls={`skill-copy-${group.id}`} aria-label={ariaId} data-aria-id={ariaId} data-aria-en={ariaEn}>
                <span class="skill-card__label" data-copy-id={group.data.copy.id.shortLabel} data-copy-en={group.data.copy.en.shortLabel}>{group.data.copy.id.shortLabel}</span>
                <span class="skill-card__detail" id={`skill-copy-${group.id}`}>
                  <span class="skill-card__detail-inner">
                    <strong data-copy-id={group.data.copy.id.title} data-copy-en={group.data.copy.en.title}>{group.data.copy.id.title}</strong>
                    <span data-copy-id={group.data.copy.id.summary} data-copy-en={group.data.copy.en.summary}>{group.data.copy.id.summary}</span>
                    <ul class="skill-chip-list">
                      {group.data.chips.map((chip) => <li data-copy-id={chip.label.id} data-copy-en={chip.label.en}>{chip.label.id}</li>)}
                    </ul>
                  </span>
                </span>
              </button>
            </article>
          );
        })}
      </div>
    </div>
    <div class="software-panel" id="software-panel" role="tabpanel" aria-labelledby="software-tab" data-skill-panel="software">
      <ul class="software-grid">
        {software.map((app) => (
          <li class="software-tile" data-v6-enter={`software:${app.id}`} data-v6-preset="editorial" data-v6-delay="0">
            <span class="software-tile__icon">
              <span class="software-tile__fallback" aria-hidden="true">{app.data.monogram}</span>
              <img src={sitePath(app.data.icon)} alt="" width="64" height="64" loading="lazy" decoding="async" data-software-icon />
            </span>
            <span>{app.data.name}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-block content-shell education-section" id="education" aria-labelledby="education-heading">
    <header class="section-heading">
      <div>
        <h2 id="education-heading" data-v6-heading data-v6-type data-v6-enter="heading:education">
          <span class="v6-heading__source" {...copyAttrs(id('education.title'), en('education.title'))}>{id('education.title')}</span>
          <span class="v6-heading__visual" aria-hidden="true">{headingSegments(id('education.title')).map((grapheme) => <span class="v6-heading__grapheme">{grapheme}</span>)}</span>
        </h2>
        <p data-v6-enter="education:intro" data-v6-preset="copy" {...copyAttrs(id('education.intro'), en('education.intro'))}>{id('education.intro')}</p>
      </div>
    </header>
    <div class="education-columns">
      <section class="education-group" aria-labelledby="formal-heading">
        <h3 id="formal-heading" data-v6-enter="education:group:formal" {...copyAttrs(id('education.formal'), en('education.formal'))}>{id('education.formal')}</h3>
        <ol class="education-timeline">
          {formalEducation.map((entry) => (
            <li class="education-entry" data-v6-enter={`education:${entry.id}`} data-v6-preset="editorial" data-v6-delay="0" data-has-logo={String(Boolean(entry.data.logo))}>
              <span class="education-entry__dot" aria-hidden="true"></span>
              {entry.data.logo && <img class="education-entry__logo" src={sitePath(entry.data.logo.src)} alt="" aria-hidden="true" width={entry.data.logo.width} height={entry.data.logo.height} loading="lazy" decoding="async" />}
              <div class="education-entry__content">
                <p class="education-entry__period" {...copyAttrs(periodLabel(entry.data.dates, 'id'), periodLabel(entry.data.dates, 'en'))}>{periodLabel(entry.data.dates, 'id')}</p>
                <h4>{entry.data.institution}</h4>
