      <div class="credential-pagination" data-credential-pagination data-v6-enter="credentials:pagination" data-v6-delay="0" hidden>
        <span class="credential-pagination__status" data-credential-page-status role="status" aria-live="polite">{id('credentials.page', { index: 1, count: credentialPages.length })}</span>
        <button class="icon-button" type="button" data-credential-previous aria-label={id('credentials.previous')} data-aria-id={id('credentials.previous')} data-aria-en={en('credentials.previous')}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button class="icon-button" type="button" data-credential-next aria-label={id('credentials.next')} data-aria-id={id('credentials.next')} data-aria-en={en('credentials.next')}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
    </header>
    <CredentialGlareEnhancement client:visible />
    <div class="credential-viewport" data-credential-viewport>
      <div class="credential-track" data-credential-track style={`--credential-page-count: ${Math.max(1, credentialPages.length)}`}>
        {credentialPages.map((page, pageIndex) => (
          <div class="credential-page" data-credential-page data-page-kind={page.kind} data-page-index={pageIndex} role="group" aria-label={id('credentials.page', { index: pageIndex + 1, count: credentialPages.length })} data-aria-id={id('credentials.page', { index: pageIndex + 1, count: credentialPages.length })} data-aria-en={en('credentials.page', { index: pageIndex + 1, count: credentialPages.length })}>
            <div class="credential-grid">
              {page.items.map((item) => {
                if (item.kind === 'real') {
                  const entry = item.entry;
                  const glareKey = `${item.kind}:${entry.id}`;
                  const media = entry.data.media;
                  const title = { id: entry.data.name, en: entry.data.name };
                  const alt = media.alt ?? { id: id('credentials.placeholderAlt'), en: en('credentials.placeholderAlt') };
                  const payload = JSON.stringify({
                    sample: false,
                    title,
                    media: { ...media, src: sitePath(media.src) },
                    alt,
                  });
                  return (
                    <a class="credential-card" href={sitePath(media.src)} target="_blank" rel="noopener noreferrer" data-v6-enter={`credential:${item.kind}:${entry.id}`} data-v6-preset="credential" data-v6-enter-target=".credential-card__entry-visual" data-v6-delay="0" data-credential-open data-credential-payload={payload} aria-label={id('credentials.open', { title: title.id })} data-aria-id={id('credentials.open', { title: title.id })} data-aria-en={en('credentials.open', { title: title.en })}>
                      <div class="credential-card__entry-visual">
                        <figure class="credential-card__frame">
                          <img src={sitePath(media.src)} alt={alt.id} data-alt-id={alt.id} data-alt-en={alt.en} width={media.width} height={media.height} loading="lazy" decoding="async" />
                          <span class="credential-glare-slot" data-credential-glare-slot data-credential-glare-key={glareKey}></span>
                        </figure>
                        <h3>{title.id}</h3>
                      </div>
                    </a>
                  );
                }

                const entry = item.entry;
                const glareKey = `${item.kind}:${entry.id}`;
                const media = entry.data.media;
                const title = { id: id('credentials.samplePreview'), en: en('credentials.samplePreview') };
                const payload = JSON.stringify({
                  sample: true,
                  title,
                  media: { ...media, src: sitePath(media.src) },
                  alt: media.alt,
                });
                return (
                  <a class="credential-card credential-card--sample" href={sitePath(media.src)} target="_blank" rel="noopener noreferrer" data-v6-enter={`credential:${item.kind}:${entry.id}`} data-v6-preset="credential" data-v6-enter-target=".credential-card__entry-visual" data-v6-delay="0" data-credential-open data-credential-sample="true" data-credential-payload={payload} aria-label={title.id} data-aria-id={title.id} data-aria-en={title.en}>
                    <div class="credential-card__entry-visual">
                      <figure class="credential-card__frame">
                        <img src={sitePath(media.src)} alt="" width={media.width} height={media.height} loading="lazy" decoding="async" />
                        <span class="credential-glare-slot" data-credential-glare-slot data-credential-glare-key={glareKey}></span>
                      </figure>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

