---
import type { CollectionEntry } from 'astro:content';

type ExperienceEntry = CollectionEntry<'experience'>;
type EducationEntry = CollectionEntry<'education'>;
type CredentialEntry = CollectionEntry<'credentials'>;
type Entry = ExperienceEntry | EducationEntry | CredentialEntry;

interface Props { entry: Entry; kind: 'experience' | 'education' | 'credential' }
const { entry, kind } = Astro.props;
const title = kind === 'experience' ? (entry as ExperienceEntry).data.organization : kind === 'education' ? (entry as EducationEntry).data.institution : (entry as CredentialEntry).data.name;
const summary = kind === 'experience' ? (entry as ExperienceEntry).data.copy.id.summary : kind === 'education' ? (entry as EducationEntry).data.copy.id.program : undefined;
---
<article class={`record-card record-card--${kind}`}>
  <h3>{title}</h3>
  {summary && <p>{summary}</p>}
</article>
