---
import { getCollection } from 'astro:content';
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import ProjectDetail from '../../components/ProjectDetail.astro';
import { getPublishedProjects } from '../../lib/projects';
import { sitePath } from '../../lib/urls';

export async function getStaticPaths() {
  const projects = await getPublishedProjects();
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { slug, title, summary } = project.data;
const siteEntries = await getCollection('site');
const profile = siteEntries.find((entry) => entry.data.kind === 'profile')?.data;
if (!profile || profile.kind !== 'profile') throw new Error('Profil situs tidak ditemukan.');
const navItems = [
  { label: 'Tentang', href: sitePath('/#about') },
  { label: 'Arsip proyek', href: sitePath('/projects/'), current: true },
  { label: 'Kontak', href: sitePath('/#contact') },
];
---

<PortfolioLayout
  title={title + ' — ' + profile.name}
  description={summary}
  canonicalPath={'/projects/' + slug + '/'}
  navItems={navItems}
>
  <div class="content-shell project-route">
    <a class="back-link" href={sitePath('/projects/')}>← Semua proyek</a>
    <ProjectDetail project={project} titleTag="h1" />
    <a class="text-link project-detail__next" href={sitePath('/projects/')}>Kembali ke arsip proyek <span aria-hidden="true">↗</span></a>
  </div>
</PortfolioLayout>
