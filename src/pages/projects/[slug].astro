---
import { getCollection, render } from 'astro:content';
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import { getPublishedProjects } from '../../lib/projects';
import { sitePath } from '../../lib/urls';

export async function getStaticPaths() {
  const projects = await getPublishedProjects();
  return Promise.all(projects.map(async (project) => ({
    params: { slug: project.data.slug },
    props: { project, rendered: await render(project) },
  })));
}

const { project, rendered } = Astro.props;
const { Content } = rendered;
const { title, summary, category, tags, repositoryUrl, demoUrl, sourceLinks, slug, cover, alt, coverWidth, coverHeight } = project.data;
const coverSource = sourceLinks.find((source) => source.label === 'Foto prototipe');
const siteEntries = await getCollection('site');
const profile = siteEntries.find((entry) => entry.data.kind === 'profile')?.data;
if (!profile || profile.kind !== 'profile') throw new Error('Profil situs tidak ditemukan.');
const navItems = [
  { label: 'Tentang', href: sitePath('/#about') },
  { label: 'Arsip proyek', href: sitePath('/projects/'), current: true },
  { label: 'Kontak', href: sitePath('/#contact') },
];
---

<PortfolioLayout
  title={`${title} — ${profile.name}`}
  description={summary}
  canonicalPath={`/projects/${slug}/`}
  navItems={navItems}
>
  <article class="project-detail content-shell">
    <a class="back-link" href={sitePath('/projects/')}>← Semua proyek</a>
    <header class="project-detail__header">
      <h1>{title}</h1>
      <p class="project-detail__category">{category}</p>
      <p class="project-detail__summary">{summary}</p>
      <ul class="tag-list" aria-label={`Teknologi yang disebut di dokumentasi ${title}`}>
        {tags.map((tag) => <li>{tag}</li>)}
      </ul>
    </header>
    {cover && (
      <figure class="project-detail__media">
        <img src={sitePath(cover)} alt={alt ?? ''} width={coverWidth} height={coverHeight} loading="eager" decoding="async" />
        <figcaption>
          <span>Foto dokumentasi repositori publik</span>
          {coverSource && <a href={coverSource.url} target="_blank" rel="noopener noreferrer">Sumber gambar</a>}
        </figcaption>
      </figure>
    )}
    <div class="project-detail__body">
      <div class="prose"><Content /></div>
      <aside class="source-panel" aria-labelledby="source-heading">
        <h2 id="source-heading">Sumber dokumentasi</h2>
        <p>Ringkasan ini mengikuti README dan berkas pada repositori publik; halaman ini tidak menyatakan peran individu.</p>
        <ul>
          {sourceLinks.map((source) => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label} <span aria-hidden="true">↗</span></a></li>)}
        </ul>
        <div class="source-panel__actions">
          {repositoryUrl && <a class="button button--primary" href={repositoryUrl} target="_blank" rel="noopener noreferrer">Buka repositori <span aria-hidden="true">↗</span></a>}
          {demoUrl && <a class="text-link" href={demoUrl} target="_blank" rel="noopener noreferrer">Buka demo <span aria-hidden="true">↗</span></a>}
        </div>
      </aside>
    </div>
    <a class="text-link project-detail__next" href={sitePath('/projects/')}>Kembali ke arsip proyek <span aria-hidden="true">↗</span></a>
  </article>
</PortfolioLayout>
