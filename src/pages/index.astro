---
import { getCollection, render } from 'astro:content';
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getFeaturedProjects, getPublishedProjects, sortProjects } from '../lib/projects';
import { sitePath } from '../lib/urls';

const siteEntries = await getCollection('site');
const profile = siteEntries.find((entry) => entry.data.kind === 'profile')?.data;
const contact = siteEntries.find((entry) => entry.data.kind === 'contact')?.data;
const settings = siteEntries.find((entry) => entry.data.kind === 'settings')?.data;
if (!profile || profile.kind !== 'profile' || !contact || contact.kind !== 'contact' || !settings || settings.kind !== 'settings') throw new Error('Profil, pengaturan, dan tautan GitHub diperlukan.');

const projects = await getPublishedProjects();
const featured = await getFeaturedProjects(settings.featuredLimit);
const heroVisualProject = featured.find((project) => Boolean(project.data.cover));
const heroVisualSource = heroVisualProject?.data.sourceLinks.find((source) => source.label === 'Foto prototipe');
const categories = [...new Set(projects.map((project) => project.data.category))].sort((a, b) => a.localeCompare(b));
const skills = sortProjects((await getCollection('skills')).filter((entry) => !entry.data.draft));
const experience = sortProjects((await getCollection('experience')).filter((entry) => !entry.data.draft));
const education = sortProjects((await getCollection('education')).filter((entry) => !entry.data.draft));
const credentials = sortProjects((await getCollection('credentials')).filter((entry) => !entry.data.draft));
const sections = sortProjects((await getCollection('sections')).filter((entry) => !entry.data.draft));
const renderedSections = await Promise.all(sections.map(async (entry) => ({ entry, content: await render(entry) })));

const navItems = [
  { label: 'Tentang', href: '#about' },
  { label: 'Proyek', href: '#projects' },
  ...(skills.length ? [{ label: 'Keahlian', href: '#skills' }] : []),
  ...(experience.length ? [{ label: 'Pengalaman', href: '#experience' }] : []),
  ...(education.length ? [{ label: 'Pendidikan', href: '#education' }] : []),
  ...(credentials.length ? [{ label: 'Kredensial', href: '#credentials' }] : []),
  { label: 'Kontak', href: '#contact' },
];
const cvHref = profile.kind === 'profile' && profile.cv
  ? (profile.cv.startsWith('https://') ? profile.cv : sitePath(profile.cv))
  : undefined;
---

<PortfolioLayout
  title={`${profile.name} — ${profile.field}`}
  description="Pilihan dokumentasi repositori publik tentang sistem sensor, embedded, kendali, telemetri, dan perangkat lunak."
  canonicalPath="/"
  navItems={navItems}
>
  <section class="hero content-shell" id="about" aria-labelledby="page-title">
    <div class="hero__copy">
      <h1 id="page-title">{profile.name}</h1>
      <p class="hero__field">{profile.field}</p>
      <p class="hero__intro">{profile.summary ?? 'Portofolio ini merangkum dokumentasi dari repositori publik yang relevan dengan sistem sensor, embedded, kendali, telemetri, dan perangkat lunak.'}</p>
      <div class="hero__actions">
        <a class="button button--primary" href="#projects">Lihat proyek pilihan <span aria-hidden="true">↓</span></a>
        <a class="button button--quiet" href={contact.github} target="_blank" rel="noopener noreferrer">Profil GitHub <span aria-hidden="true">↗</span></a>
        {cvHref && <a class="button button--quiet" href={cvHref} target={profile.cv?.startsWith('https://') ? '_blank' : undefined} rel={profile.cv?.startsWith('https://') ? 'noopener noreferrer' : undefined}>{profile.cvLabel ?? 'Lihat CV'} <span aria-hidden="true">↗</span></a>}
      </div>
    </div>
    <aside class="hero-panel" aria-label="Dokumentasi proyek publik">
      {heroVisualProject?.data.cover && (
        <figure class="hero-panel__figure">
          <a href={sitePath(`/projects/${heroVisualProject.data.slug}/`)}>
            <img src={sitePath(heroVisualProject.data.cover)} alt={heroVisualProject.data.alt ?? ''} width={heroVisualProject.data.coverWidth} height={heroVisualProject.data.coverHeight} loading="eager" decoding="async" fetchpriority="high" />
          </a>
          <figcaption class="hero-panel__caption">
            <div>
              <p>Foto dokumentasi repositori publik</p>
              <a href={sitePath(`/projects/${heroVisualProject.data.slug}/`)}>{heroVisualProject.data.title}</a>
            </div>
            {heroVisualSource && <a href={heroVisualSource.url} target="_blank" rel="noopener noreferrer">Sumber foto</a>}
          </figcaption>
        </figure>
      )}
      <p class="hero-panel__detail">{projects.length} repositori publik dalam {categories.length} kategori.</p>
      <a class="hero-panel__link" href={sitePath('/projects/')}>Jelajahi arsip lengkap <span aria-hidden="true">↗</span></a>
    </aside>
  </section>

  <section class="section-block content-shell" id="projects" aria-labelledby="projects-heading">
    <div class="section-heading">
      <div>
        <h2 id="projects-heading">Proyek pilihan</h2>
      </div>
      <a class="text-link section-heading__link" href={sitePath('/projects/')}>Arsip lengkap <span aria-hidden="true">↗</span></a>
    </div>
    {featured.length > 0 ? (
      <div class="project-grid project-grid--featured">
        {featured.map((project) => <ProjectCard project={project} />)}
      </div>
    ) : (
      <p class="empty-note">Belum ada proyek pilihan yang ditandai.</p>
    )}
  </section>

  {skills.length > 0 && (
    <section class="section-block content-shell" id="skills" aria-labelledby="skills-heading">
      <div class="section-heading"><div><h2 id="skills-heading">Keahlian</h2></div></div>
      <div class="simple-grid">
        {skills.map((skill) => (
          <article class="simple-card"><h3>{skill.data.name}</h3><p class="category-label">{skill.data.category}</p>{skill.data.context && <p>{skill.data.context}</p>}</article>
        ))}
      </div>
    </section>
  )}

  {experience.length > 0 && (
    <section class="section-block content-shell" id="experience" aria-labelledby="experience-heading">
      <div class="section-heading"><div><h2 id="experience-heading">Pengalaman</h2></div></div>
      <div class="simple-grid">
        {experience.map((entry) => (
          <article class="simple-card"><h3>{entry.data.role}</h3><p class="category-label">{entry.data.period ?? 'Pengalaman'}</p><p class="simple-card__meta">{entry.data.organization}</p><p>{entry.data.summary}</p></article>
        ))}
      </div>
    </section>
  )}

  {education.length > 0 && (
    <section class="section-block content-shell" id="education" aria-labelledby="education-heading">
      <div class="section-heading"><div><h2 id="education-heading">Pendidikan</h2></div></div>
      <div class="simple-grid">
        {education.map((entry) => (
          <article class="simple-card"><h3>{entry.data.program}</h3><p class="category-label">{entry.data.period ?? 'Pendidikan'}</p><p class="simple-card__meta">{entry.data.institution}</p>{entry.data.summary && <p>{entry.data.summary}</p>}</article>
        ))}
      </div>
    </section>
  )}

  {credentials.length > 0 && (
    <section class="section-block content-shell" id="credentials" aria-labelledby="credentials-heading">
      <div class="section-heading"><div><h2 id="credentials-heading">Kredensial</h2></div></div>
      <div class="simple-grid">
        {credentials.map((entry) => (
          <article class="simple-card"><h3>{entry.data.name}</h3><p class="category-label">{entry.data.issuedAt ?? entry.data.issuer}</p>{entry.data.verifyUrl && <a class="text-link" href={entry.data.verifyUrl} target="_blank" rel="noopener noreferrer">Verifikasi <span aria-hidden="true">↗</span></a>}</article>
        ))}
      </div>
    </section>
  )}

  {renderedSections.map(({ entry, content }) => {
    const { Content } = content;
    return (
      <section class="section-block content-shell content-section" id={entry.data.slug} aria-labelledby={`${entry.data.slug}-heading`}>
        <div class="section-heading"><div><h2 id={`${entry.data.slug}-heading`}>{entry.data.title}</h2></div></div>
        <div class="prose"><Content /></div>
      </section>
    );
  })}

  <section class="contact-block content-shell" id="contact" aria-labelledby="contact-heading">
    <div><h2 id="contact-heading">Terhubung lewat GitHub</h2></div>
    <div class="hero__actions contact-actions">
      <a class="button button--primary" href={contact.github} target="_blank" rel="noopener noreferrer">Buka profil Yunachz <span aria-hidden="true">↗</span></a>
      {contact.email && <a class="button button--quiet" href={`mailto:${contact.email}`}>Email <span aria-hidden="true">↗</span></a>}
      {contact.linkedin && <a class="button button--quiet" href={contact.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>}
    </div>
  </section>
</PortfolioLayout>
